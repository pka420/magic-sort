# Where the SQLite file lives. Relative paths resolve against the directory
# uvicorn is started from, so run it from backend/ or set an absolute path.
DATABASE_URL=sqlite:///./magic_sort.db

# Signing key for the access tokens. Set a long random value in production.
SECRET_KEY=change-me

# Minutes before an access token stops being accepted. Seven days by default.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Leave blank to leave "Sign in with Google" turned off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://magic-sort.from-delhi.net/api/auth/google/callback

# The game itself, used to send a Google user back with their token.
FRONTEND_URL=https://magic-sort.from-delhi.net/

# Email (verification / password reset), sent through Resend. Leave
# EMAIL_ENABLED=false and the tokens are printed to the server log instead.
# Resend's SMTP username is literally "resend" and the password is an API key
# (re_...). The "from" address must belong to a domain verified in Resend.
# Port 465 is implicit TLS; 587 is STARTTLS.
EMAIL_ENABLED=false
SMTP_SERVER=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxx
SMTP_FROM=noreply@magic-sort.from-delhi.net
